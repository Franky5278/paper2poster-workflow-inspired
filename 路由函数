# --- 异步清理函数 ---
async def _cleanup_temp_dir(path: Path):
    """异步清理指定的临时目录及其内容。"""
    if path.exists() and path.is_dir():
        try:
            shutil.rmtree(path)
            logger.info(f"成功清理临时目录: {path}")
        except OSError as e:
            logger.error(f"清理临时目录失败 {path}: {e}")
